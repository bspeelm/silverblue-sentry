---
source: crates/sentry-network/src/config.rs
expression: text
---
# sentry's configuration: the networks sentry watches through their routers.
# Written by sentry: change it in the Config tab or with `sentry config`. Editing it
# in $EDITOR is fine, but comments are not kept: the next save writes it again
# from what it says, keeping the file before beside it (network_config.yaml.bak-<time>).

networks:
  home:
    router:
      ssh: myrouter
    expect:
      zones:
        dmz:
          - dmz
        lan:
          - lan
        wan:
          - wan
          - wan6
      forwards:
        - name: web
          port: 443
          to: "192.0.2.10"
        - name: game
          proto: udp
          port: 8000-8010
          to: "192.0.2.20"
      listeners:
        - tcp:22@lan
        - tcp:443@lan
        - udp:53@lan
      services:
        - odhcpd
    devices:
      - name: nas
        mac: 02:00:5e:00:53:01
      - name: panel
        mac: 02:00:5e:00:53:02
        leave_alone: true
      - name: phone
        hostname: my-phone
        private_mac: true
    maintenance:
      items:
        - id: firmware
          kind: firmware
        - id: packages
          kind: packages
        - id: backup
          kind: backup
      cadence:
        - workflow: config-backup
          every: 30d
        - workflow: package-update
          every: 60d
    notes:
      - ~/notes/network.md
